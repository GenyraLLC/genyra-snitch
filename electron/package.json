{
  "name": "genyra-snitch",
  "version": "0.1.0-alpha.2",
  "description": "Genyra Snitch by Genyra LLC \u2014 native network visibility and application firewall controls",
  "main": "main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "build:dir": "electron-builder --linux --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.genyra.snitch",
    "productName": "Genyra Snitch",
    "directories": {
      "output": "../dist/installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.png",
      "logo.png",
      "genyra-light.png"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "../target/release/genyra-snitch",
        "to": "genyra-snitch"
      },
      {
        "from": "../ui/dist",
        "to": "frontend_dist"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon.png",
      "synopsis": "Know what your apps connect to",
      "description": "Genyra Snitch by Genyra LLC \u2014 native network visibility and application firewall controls",
      "maintainer": "Genyra LLC",
      "syncDesktopName": true,
      "artifactName": "${productName}-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/GenyraLLC/genyra-snitch",
  "desktopName": "Genyra Snitch",
  "author": "Genyra LLC",
  "dependencies": {}
}
